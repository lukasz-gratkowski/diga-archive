<Application
    x:Class="Diga.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DigaCanvasBrush" Color="#F2F6FB" />
                    <SolidColorBrush x:Key="DigaSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DigaBorderBrush" Color="#D6E2EC" />
                    <SolidColorBrush x:Key="DigaInkBrush" Color="#142C42" />
                    <SolidColorBrush x:Key="DigaMutedBrush" Color="#536A7E" />
                    <SolidColorBrush x:Key="DigaTealSurfaceBrush" Color="#E0F5F0" />
                    <SolidColorBrush x:Key="DigaTealInkBrush" Color="#00665D" />
                    <SolidColorBrush x:Key="DigaAmberSurfaceBrush" Color="#FFF0D4" />
                    <SolidColorBrush x:Key="DigaAmberInkBrush" Color="#855400" />
                    <SolidColorBrush x:Key="DigaVioletSurfaceBrush" Color="#EEE9FE" />
                    <SolidColorBrush x:Key="DigaVioletInkBrush" Color="#6441A6" />
                    <SolidColorBrush x:Key="DigaCoralSurfaceBrush" Color="#FCE8E1" />
                    <SolidColorBrush x:Key="DigaCoralInkBrush" Color="#A84432" />
                    <SolidColorBrush x:Key="DigaPrimaryBrush" Color="#087C74" />
                    <SolidColorBrush x:Key="DigaOnPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DigaPrimaryHoverBrush" Color="#066D66" />
                    <SolidColorBrush x:Key="DigaPrimaryPressedBrush" Color="#055F59" />
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="DigaPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="DigaPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonForeground" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="DigaPrimaryHoverBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="DigaPrimaryHoverBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="DigaPrimaryPressedBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="DigaPrimaryPressedBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DigaCanvasBrush" />
                    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="DigaBorderBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DigaCanvasBrush" Color="#0B1422" />
                    <SolidColorBrush x:Key="DigaSurfaceBrush" Color="#142234" />
                    <SolidColorBrush x:Key="DigaBorderBrush" Color="#294057" />
                    <SolidColorBrush x:Key="DigaInkBrush" Color="#EDF6FD" />
                    <SolidColorBrush x:Key="DigaMutedBrush" Color="#A9BED1" />
                    <SolidColorBrush x:Key="DigaTealSurfaceBrush" Color="#123B40" />
                    <SolidColorBrush x:Key="DigaTealInkBrush" Color="#67E4CD" />
                    <SolidColorBrush x:Key="DigaAmberSurfaceBrush" Color="#3C2E1D" />
                    <SolidColorBrush x:Key="DigaAmberInkBrush" Color="#FFD08A" />
                    <SolidColorBrush x:Key="DigaVioletSurfaceBrush" Color="#2D2645" />
                    <SolidColorBrush x:Key="DigaVioletInkBrush" Color="#C8AEFF" />
                    <SolidColorBrush x:Key="DigaCoralSurfaceBrush" Color="#40292D" />
                    <SolidColorBrush x:Key="DigaCoralInkBrush" Color="#FFB29E" />
                    <SolidColorBrush x:Key="DigaPrimaryBrush" Color="#5DE0C6" />
                    <SolidColorBrush x:Key="DigaOnPrimaryBrush" Color="#082721" />
                    <SolidColorBrush x:Key="DigaPrimaryHoverBrush" Color="#75E9D3" />
                    <SolidColorBrush x:Key="DigaPrimaryPressedBrush" Color="#46CDB5" />
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="DigaPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="DigaPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonForeground" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="DigaPrimaryHoverBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="DigaPrimaryHoverBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="DigaPrimaryPressedBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="DigaPrimaryPressedBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DigaCanvasBrush" />
                    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="DigaBorderBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DigaCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DigaSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DigaBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DigaInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DigaMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DigaTealSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DigaTealInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DigaAmberSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DigaAmberInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DigaVioletSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DigaVioletInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DigaCoralSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DigaCoralInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DigaPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DigaOnPrimaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="DigaPrimaryHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DigaPrimaryPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="DigaPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="DigaPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonForeground" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="DigaPrimaryHoverBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="DigaPrimaryHoverBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="DigaPrimaryPressedBrush" />
                    <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="DigaPrimaryPressedBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="DigaOnPrimaryBrush" />
                    <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DigaCanvasBrush" />
                    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="DigaSurfaceBrush" />
                    <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="DigaBorderBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="DigaCanvasStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource DigaCanvasBrush}" />
            </Style>
            <Style x:Key="DigaMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DigaMutedBrush}" />
            </Style>
            <Style x:Key="DigaAccentTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DigaTealInkBrush}" />
            </Style>
            <Style x:Key="DigaTitleTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DigaInkBrush}" />
            </Style>
            <Style x:Key="DigaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DigaSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DigaBorderBrush}" />
            </Style>
            <Style x:Key="DigaFeaturedCardStyle" TargetType="Border" BasedOn="{StaticResource DigaCardStyle}">
                <Setter Property="Background" Value="{ThemeResource DigaTealSurfaceBrush}" />
            </Style>
            <Style x:Key="DigaPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DigaTealSurfaceBrush}" />
            </Style>
            <Style x:Key="DigaStatusBarStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource DigaSurfaceBrush}" />
            </Style>
            <Style x:Key="DigaTealCardStyle" TargetType="Border" BasedOn="{StaticResource DigaCardStyle}">
                <Setter Property="Background" Value="{ThemeResource DigaTealSurfaceBrush}" />
            </Style>
            <Style x:Key="DigaTealTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DigaTealInkBrush}" />
            </Style>
            <Style x:Key="DigaTealIconStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{ThemeResource DigaTealInkBrush}" />
            </Style>
            <Style x:Key="DigaTealButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource DigaTealSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DigaTealInkBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DigaInkBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <Style x:Key="DigaAmberCardStyle" TargetType="Border" BasedOn="{StaticResource DigaCardStyle}">
                <Setter Property="Background" Value="{ThemeResource DigaAmberSurfaceBrush}" />
            </Style>
            <Style x:Key="DigaAmberTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DigaAmberInkBrush}" />
            </Style>
            <Style x:Key="DigaAmberIconStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{ThemeResource DigaAmberInkBrush}" />
            </Style>
            <Style x:Key="DigaAmberButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource DigaAmberSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DigaAmberInkBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DigaInkBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <Style x:Key="DigaVioletCardStyle" TargetType="Border" BasedOn="{StaticResource DigaCardStyle}">
                <Setter Property="Background" Value="{ThemeResource DigaVioletSurfaceBrush}" />
            </Style>
            <Style x:Key="DigaVioletTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DigaVioletInkBrush}" />
            </Style>
            <Style x:Key="DigaVioletIconStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{ThemeResource DigaVioletInkBrush}" />
            </Style>
            <Style x:Key="DigaVioletButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource DigaVioletSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DigaVioletInkBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DigaInkBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <Style x:Key="DigaCoralCardStyle" TargetType="Border" BasedOn="{StaticResource DigaCardStyle}">
                <Setter Property="Background" Value="{ThemeResource DigaCoralSurfaceBrush}" />
            </Style>
            <Style x:Key="DigaCoralTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DigaCoralInkBrush}" />
            </Style>
            <Style x:Key="DigaCoralIconStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{ThemeResource DigaCoralInkBrush}" />
            </Style>
            <Style x:Key="DigaCoralButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource DigaCoralSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DigaCoralInkBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DigaInkBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <Style x:Key="DigaJourneyButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource DigaSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DigaBorderBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DigaInkBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <Style x:Key="DigaAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource DigaPrimaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DigaOnPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DigaPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
