<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org and from nowhere else: <clear /> drops whatever feeds the build PC's own NuGet settings name,
     and the mapping makes nuget.org the only feed any package ID may be taken from. What each package must contain is
     recorded in the packages.lock.json beside each project. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
